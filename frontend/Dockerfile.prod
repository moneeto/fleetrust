# --- ETAPA 1: BUILD (Generar archivos estáticos) ---
FROM node:22-alpine as build-stage
WORKDIR /app

# Copia dependencias e instala
COPY package*.json ./
RUN npm install

# Copia el código fuente
COPY . .

# Comando de build que genera la carpeta de producción (ej: 'dist' o 'build')
RUN npm run build


# --- ETAPA 2: PRODUCTION (Servir con Nginx) ---
FROM nginx:alpine

# Copia el archivo de configuración de Nginx (Opcional, si tienes uno personalizado)
# COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia los archivos estáticos generados en la etapa 'build-stage'
# Asumimos que 'npm run build' genera una carpeta llamada 'dist'
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Puerto de Nginx
EXPOSE 80

# Comando para que Nginx se ejecute en primer plano
CMD ["nginx", "-g", "daemon off;"]