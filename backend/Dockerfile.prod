# 1. ETAPA BASE: Usamos la imagen oficial de Node.js
FROM node:22-alpine as base

# 2. DEFINIMOS EL DIRECTORIO DE TRABAJO
WORKDIR /usr/src/app

# 3. COPIAMOS LOS ARCHIVOS DE DEPENDENCIAS E INSTALAMOS
# Solo copiamos los archivos de manifiesto para aprovechar el caché de Docker
COPY package*.json ./
RUN npm install

# 4. COPIAMOS EL CÓDIGO FUENTE
COPY . .

# 5. ESPECIFICAMOS EL PUERTO DE LA APLICACIÓN
EXPOSE 9000

# 6. COMANDO DE INICIO
# Este es el comando final que corre la aplicación
CMD [ "node", "server.js" ]