# Copiar a .env y ajustar. Nunca commitear .env real (RNF-03).
# Apunta a la MISMA base que fleetrust/admin (AD1: base única compartida).
# Este repo nunca escribe el esquema, solo lo consume (AD3).

# --- apps/api ---
NODE_ENV=development
PORT=5001
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- apps/web ---
# Server-only: el navegador nunca ve esta URL, solo el server de Next.js al
# reenviar /api/* (ver rewrites() en next.config.mjs). No usar NEXT_PUBLIC_*
# acá: el front habla siempre con su propio origen.
API_ORIGIN=http://localhost:5001
WEB_ORIGIN=http://localhost:5000
WEB_PORT=5000
